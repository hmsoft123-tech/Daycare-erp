NEXT_PUBLIC_DEFAULT_TENANT=kinder-pilot

# --- KinderPilot backend (server-only; the browser talks to /api/bff and /api/public) ---
API_BASE_URL=https://api-dev.drsofiasdaycare.com
# Production refuses http:// unless this is "true" (credentials would travel unencrypted).
ALLOW_INSECURE_API_HTTP=false

# Signs the session cookie. 32+ random chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Root domains whose subdomain is the tenant (schoola.drsofiasdaycare.com → "schoola").
NEXT_PUBLIC_TENANT_ROOT_DOMAINS=kinderpilot.com,drsofiasdaycare.com
# Local dev: open http://<subdomain>.localhost:3000 (e.g. http://schoola.localhost:3000) to act as
# that tenant — no hosts-file entry needed.
# TENANT_SUBDOMAIN pins one school on hosts that carry no tenant subdomain: plain localhost or a
# *.vercel.app preview link (e.g. TENANT_SUBDOMAIN=schoola). Leave unset once real tenant domains are live.
TENANT_SUBDOMAIN=
# Local dev only (ignored in production): "true" still calls the real tenant/login APIs,
# but signs you in as a placeholder admin when they fail.
NEXT_PUBLIC_DEV_AUTH_BYPASS=false
# Role-based UI restrictions (lib/rbac.ts). "false" = every signed-in user sees everything
# (development); "true" = menus, pages and buttons follow the user's roles. Unset: off in dev, on in production.
NEXT_PUBLIC_RBAC_ENFORCE=false
# Local dev only: role / permissions of the bypass user — test what each role sees.
# e.g. DEV_ROLES=TEACHER   DEV_ROLES=ACCOUNTANT   DEV_ROLES=STAFF  DEV_PERMISSIONS=FEE_LOCK
DEV_ROLES=COMPANY_ADMIN
DEV_PERMISSIONS=
# Local dev only: server → backend calls (tenant resolve, login, BFF) are printed to the
# `next dev` terminal with payload + response — the browser never sees them. "false" silences it.
LOG_BACKEND_CALLS=true

# Comma-separated origins allowed to call this app's legacy mock /api routes (e.g. the parent portal).
# localhost:3001 is allowed automatically in development only.
ALLOWED_ORIGINS=
